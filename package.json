{
	"name": "i18n-cities",
	"version": "0.0.0",
	"description": "Offline city search with translated city, region and country names, from GeoNames",
	"repository": {
		"type": "git",
		"url": "https://github.com/marcmarine/i18n-cities.git"
	},
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./10000": {
			"types": "./dist/10000.d.ts",
			"import": "./dist/10000.js"
		},
		"./1000": {
			"types": "./dist/1000.d.ts",
			"import": "./dist/1000.js"
		},
		"./locales/*": {
			"types": "./dist/locales/*.d.ts",
			"import": "./dist/locales/*.js"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"cities",
		"geonames",
		"i18n",
		"geocoding",
		"offline",
		"search",
		"timezone"
	],
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts ./src/10000.ts ./src/1000.ts ./src/locales/*.ts --outdir dist --target node --splitting && tsc -p tsconfig.build.json",
		"build:data": "bun scripts/build-data.ts",
		"test": "bun test",
		"typecheck": "tsc",
		"lint": "biome check",
		"format": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/bun": "^1.4.3",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	}
}
